# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# From @BotFather. Revoke any token that was ever pasted into a chat.
TELEGRAM_BOT_TOKEN=
# The channel's id, from `uv run inv chat-id` (channels start with -100).
CHAT_ID=

CITY=Vienna
POST_AT=07:00
TZ=Europe/Vienna
# metric or imperial
UNITS=metric
