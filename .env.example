# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# From @BotFather. Revoke any token that was ever pasted into a chat.
TELEGRAM_BOT_TOKEN=
# The channel's id, from `uv run inv chat-id` (channels start with -100).
CHAT_ID=

# One or more cities, separated by ; (a comma belongs to the place: Paris, Texas)
CITY=Vienna
# On GitHub Actions the post time also lives in .github/workflows/daily.yml's crons
POST_AT=07:00
TZ=Europe/Vienna
# metric or imperial
UNITS=metric
# The answer bot's @username, for the daily bot's description (optional)
ANSWER_BOT=

# Stage 2 answer bot (a second bot from @BotFather), for `uv run inv answer`
ANSWER_BOT_TOKEN=
